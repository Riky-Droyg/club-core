{
  "name": "club-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=$DATABASE_URL_TEST DIRECT_URL=$DATABASE_URL_TEST vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:sync-athlete-statuses": "tsx scripts/sync-athlete-statuses.ts",
    "mail:up": "docker compose up -d mailpit",
    "mail:down": "docker compose stop mailpit",
    "load:smoke": "k6 run load/k6-smoke.js",
    "dev:mail": "docker compose up -d mailpit && EMAIL_PROVIDER=mailpit EMAIL_FROM=taskflow@localhost.test next dev --webpack",
    "sprite": "svg-sprite --symbol --dest=public/icons --symbol-dest=. --symbol-sprite=sprite.svg 'src/assets/icons/**/*.svg'"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.27",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "better-auth": "^1.6.27",
    "dotenv": "^17.4.2",
    "modern-normalize": "^3.0.1",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "svg-sprite": "^2.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
