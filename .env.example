# Runtime connection. Use a pooled URL in serverless production environments.
DATABASE_URL="postgresql://clubcore:clubcore@localhost:5432/clubcore?schema=public"

# Direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_URL="postgresql://clubcore:clubcore@localhost:5432/clubcore?schema=public"

# Dedicated disposable database used only by integration tests.
DATABASE_URL_TEST="postgresql://clubcore:clubcore@localhost:5432/clubcore_test?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# local | test | staging | production. Staging/production enable strict safety checks.
APP_ENV="local"
APP_VERSION="development"

# `mailpit` provides a safe local inbox at http://localhost:8025. Use `resend` in staging/production.
EMAIL_PROVIDER="mailpit"
EMAIL_FROM="clubcore@example.com"
RESEND_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT="1025"

# Optional Sentry monitoring. The installed SDK stays inactive when the DSN is empty.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="local"
NEXT_PUBLIC_APP_VERSION="development"
